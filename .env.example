# OpenAI
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Gemini provider experiment
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# Database
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_NAME=job_market_portfolio
DATABASE_USER=your_username
DATABASE_PASSWORD=your_password
DATABASE_CHARSET=utf8mb4

# NER model
NER_MODEL=Nucha/Nucha_ITSkillNER_BERT
NER_CONFIDENCE_THRESHOLD=0.5

# Processing
LLM_BATCH_SIZE=10
# Set to 0 to process all pending records.
RECORD_LIMIT=0
MAX_PROMPT_CHARS=12000

# Logging
LOG_LEVEL=INFO
LOG_FILE=skill_extraction.log

# Debugging
DEBUG_LLM_EMPTY=false
DEBUG_LLM_EMPTY_MAX=10